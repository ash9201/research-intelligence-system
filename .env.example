# Environment Configuration - Copy to .env and update with your settings

# LLM Provider Configuration
# Choose one of: gemini, openrouter, openai, anthropic, or ollama
LLM_PROVIDER=gemini
LLM_MODEL=gemini-3.5-flash

# Gemini Configuration (OpenAI-compatible endpoint)
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/

# OpenRouter Configuration (OpenAI-compatible development provider)
OPENROUTER_API_KEY=your_openrouter_api_key_here
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# OpenAI Configuration (if using OpenAI)
OPENAI_API_KEY=your_openai_api_key_here

# Anthropic Configuration (if using Claude)
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# Local LLM Configuration (if using Ollama)
OLLAMA_API_URL=http://localhost:11434
OLLAMA_MODEL=llama2

# Embedding Model Configuration
EMBEDDING_MODEL=all-MiniLM-L6-v2
EMBEDDING_DIM=384

# Retrieval Configuration
BM25_K1=1.5
BM25_B=0.75
RETRIEVAL_TOP_K=10
HYBRID_ALPHA=0.5  # Weight for hybrid fusion (0.5 = equal weight)
FUSION_STRATEGY=weighted  # weighted or rrf
RRF_K=60

# Chunking Configuration
CHUNKING_STRATEGY=recursive  # fixed, sentence, or recursive
CHUNK_SIZE=512
CHUNK_OVERLAP=128

# Reranking Configuration
RERANKER_MODEL=cross-encoder/ms-marco-MiniLM-L-12-v2
RERANKER_TOP_K=5

# Application Configuration
APP_ENV=development
DEBUG=true
LOG_LEVEL=INFO

# Storage Configuration
DATA_DIR=./data
DOCUMENTS_DIR=./data/documents
INDEXES_DIR=./data/indexes
EXPERIMENTS_DIR=./data/experiments

# API Configuration
API_HOST=0.0.0.0
API_PORT=8000

# Streamlit Configuration
STREAMLIT_SERVER_PORT=8501
